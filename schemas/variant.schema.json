{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Step 7 variant blocks",
 "type": "object",
 "required": [
  "arm",
  "gap_id",
  "baseline_hash",
  "changes",
  "self_check"
 ],
 "properties": {
  "arm": {
   "type": "string",
   "minLength": 1
  },
  "gap_id": {
   "type": "string",
   "minLength": 1
  },
  "baseline_hash": {
   "type": "string",
   "minLength": 1
  },
  "changes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "block_id",
     "slot",
     "text",
     "evidence_ids",
     "label",
     "reason"
    ],
    "properties": {
     "evidence_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[A-Z]{2,5}-[A-Za-z0-9-]+$"
      },
      "minItems": 1
     },
     "label": {
      "enum": [
       "CHECKED",
       "CALC",
       "VENDOR",
       "SEMRUSH",
       "AUDIT",
       "PROPOSED",
       "UNCHECKED"
      ]
     },
     "reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
     },
     "block_id": {
      "type": "string",
      "minLength": 1
     },
     "slot": {
      "enum": [
       "headline",
       "subhead",
       "body",
       "cta",
       "proof",
       "item"
      ]
     },
     "text": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "self_check": {
   "type": "object",
   "required": [
    "promise_used",
    "alternative_beaten",
    "evidence_ids_used",
    "swap_test",
    "audiences_served",
    "rules_checked",
    "gaps"
   ],
   "properties": {
    "evidence_ids_used": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "gaps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "promise_used": {
     "type": "string"
    },
    "alternative_beaten": {
     "type": "string"
    },
    "swap_test": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "line",
       "rival_could_print",
       "why"
      ],
      "properties": {
       "line": {
        "type": "string"
       },
       "rival_could_print": {
        "type": "boolean"
       },
       "why": {
        "type": "string"
       }
      }
     }
    },
    "audiences_served": {
     "type": "array"
    },
    "rules_checked": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 }
}
