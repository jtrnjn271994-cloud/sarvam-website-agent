{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Step 8 validation results",
 "type": "object",
 "required": [
  "results",
  "canaries_passed"
 ],
 "properties": {
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check",
     "target",
     "result"
    ],
    "properties": {
     "check": {
      "type": "string",
      "minLength": 1
     },
     "target": {
      "type": "string",
      "minLength": 1
     },
     "result": {
      "enum": [
       "pass",
       "fail",
       "held"
      ]
     },
     "cited_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "reason": {
      "type": "string"
     }
    }
   }
  },
  "canaries_passed": {
   "type": "boolean"
  },
  "self_check": {
   "type": "object",
   "properties": {
    "gaps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 }
}
