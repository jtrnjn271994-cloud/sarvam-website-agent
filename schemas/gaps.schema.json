{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Step 5 ranked gaps",
 "type": "object",
 "required": [
  "gaps"
 ],
 "properties": {
  "gaps": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "gap_id",
     "rank",
     "block_ids",
     "rule_ids",
     "effort"
    ],
    "properties": {
     "gap_id": {
      "type": "string",
      "minLength": 1
     },
     "rank": {
      "type": "integer",
      "minimum": 1
     },
     "block_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     },
     "rule_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     },
     "effort": {
      "enum": [
       "small",
       "medium",
       "large"
      ]
     },
     "evidence_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "self_check": {
   "type": "object",
   "properties": {
    "gaps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 }
}
