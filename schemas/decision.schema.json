{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Approval decision. Only a person writes it.",
 "type": "object",
 "required": [
  "gate",
  "decision",
  "answers",
  "hash",
  "date",
  "decided_by"
 ],
 "properties": {
  "gate": {
   "enum": [
    "approval"
   ]
  },
  "decision": {
   "enum": [
    "approve",
    "revise",
    "decline"
   ]
  },
  "reason_code": {
   "enum": [
    "wrong_buyer",
    "offer_not_real",
    "not_live_page",
    "scores_unfair",
    "evidence_too_weak",
    "rival_can_say_it",
    "missing_proof",
    "buyer_would_not_say_it",
    "off_brand",
    "wrong_gap",
    "other"
   ]
  },
  "reason_text": {
   "type": "string"
  },
  "answers": {
   "type": "object",
   "additionalProperties": {
    "enum": [
     "yes",
     "no"
    ]
   }
  },
  "hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{16,64}$"
  },
  "date": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "decided_by": {
   "type": "string",
   "minLength": 2,
   "not": {
    "enum": [
     "agent",
     "code",
     "jev",
     "model",
     "claude",
     "llm"
    ]
   }
  },
  "self_check": {
   "type": "object",
   "properties": {
    "gaps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 }
}
