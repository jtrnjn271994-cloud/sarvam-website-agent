{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Step 1a capture",
 "type": "object",
 "required": [
  "url",
  "captured_on",
  "review_by",
  "widths",
  "blocks",
  "click_path"
 ],
 "properties": {
  "url": {
   "type": "string",
   "minLength": 1
  },
  "captured_on": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "review_by": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "widths": {
   "type": "array",
   "items": {
    "type": "integer"
   },
   "minItems": 2
  },
  "blocks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "text",
     "screenshots"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "kind": {
      "enum": [
       "hero",
       "text",
       "list",
       "cards",
       "faq",
       "tabs",
       "table",
       "form",
       "proof",
       "cta",
       "footer",
       "other"
      ]
     },
     "text": {
      "type": "string"
     },
     "controls": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "images": {
      "type": "integer",
      "minimum": 0
     },
     "opened": {
      "type": "boolean"
     },
     "screenshots": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     }
    }
   }
  },
  "click_path": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "control",
     "target_url",
     "status"
    ],
    "properties": {
     "control": {
      "type": "string",
      "minLength": 1
     },
     "target_url": {
      "type": "string"
     },
     "status": {
      "enum": [
       "captured",
       "failed",
       "not_collected"
      ]
     }
    }
   }
  },
  "seo": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string"
    },
    "meta_description": {
     "type": "string"
    },
    "h1_count": {
     "type": "integer"
    },
    "json_ld_types": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "self_check": {
   "type": "object",
   "properties": {
    "gaps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 }
}
