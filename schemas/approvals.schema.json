{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Approval checkpoint (step 9), as agent/runlib.py reads it. Only a person writes it.",
 "type": "object",
 "required": [
  "decision",
  "variant",
  "draft_hash",
  "date"
 ],
 "properties": {
  "decision": {
   "enum": [
    "approved",
    "rejected"
   ]
  },
  "variant": {
   "type": "string",
   "minLength": 1
  },
  "draft_hash": {
   "type": "string",
   "pattern": "^[0-9a-f]{16,64}$"
  },
  "date": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "via": {
   "type": "string"
  },
  "reason_code": {
   "enum": [
    "wrong_buyer",
    "offer_not_real",
    "not_live_page",
    "scores_unfair",
    "evidence_too_weak",
    "rival_can_say_it",
    "missing_proof",
    "buyer_would_not_say_it",
    "off_brand",
    "wrong_gap",
    "other"
   ]
  },
  "reason_text": {
   "type": "string"
  },
  "self_check": {
   "type": "object",
   "properties": {
    "gaps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 }
}
