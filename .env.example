# Copy this file to .env and add your own key:   cp .env.example .env
# .env is ignored by git. Never commit it. This file holds names only, no keys.
# On Vercel, set the same names under Project Settings > Environment Variables.

# One OpenRouter key serves every model call (reasoning, writer, Jev, Judge 2).
# Create a dedicated key and set a credit limit on it at openrouter.ai.
OPENROUTER_API_KEY=

# Optional: swap a model role. Leave empty to use agent/models.json.
MODEL_REASONING=
MODEL_WRITER=
MODEL_JUDGE1=
MODEL_JUDGE2=

# Optional: spend cap in US dollars for one run. Default 1.00.
MAX_RUN_USD=

# Optional: another OpenRouter-compatible base URL, and another knowledge folder.
OPENROUTER_BASE_URL=
KNOWLEDGE_DIR=
