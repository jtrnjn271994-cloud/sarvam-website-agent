# Copy this file to .env and add your own key:   cp .env.example .env
# .env is ignored by git. Never commit it. This file holds names only, no keys.
# On Vercel, set the same names under Project Settings > Environment Variables.

# One OpenRouter key serves every model call (reasoning, writer, Jev, Judge 2).
# Create a dedicated key and set a credit limit on it at openrouter.ai.
OPENROUTER_API_KEY=

# Optional: swap a model role. Leave empty to use agent/models.json.
MODEL_REASONING=
MODEL_WRITER=
MODEL_JUDGE1=
MODEL_JUDGE2=

# Optional: spend cap in US dollars for one run. Default 1.00.
MAX_RUN_USD=

# Optional: another OpenRouter-compatible base URL, and another knowledge folder.
OPENROUTER_BASE_URL=
KNOWLEDGE_DIR=

# ---- Website only (scripts/push_env.sh copies these to Vercel) ----
# Supabase project that stores website runs, approvals and jobs (tables sarvam_agent_files, sarvam_agent_jobs).
SUPABASE_URL=
# Supabase secret key (server side only; it never reaches the browser).
SUPABASE_SERVICE_KEY=
# Owner code: needed on the website to draft or approve page setup. Any long random string.
OWNER_TOKEN=
# Optional limits. Defaults: 3.00 dollars a day for the whole site, 3 runs a day per visitor.
DAILY_USD_CAP=
RUNS_PER_VISITOR_PER_DAY=
